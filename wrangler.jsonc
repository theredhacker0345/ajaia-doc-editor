{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ajaia-doc-editor",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ajaia-docs",
      // After creating the D1 database (dashboard or `wrangler d1 create ajaia-docs`),
      // paste its database_id here.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
  // APP_SECRET is intentionally NOT here — set it as a real Secret so it is never
  // committed: dashboard -> Worker -> Settings -> Variables and Secrets, or
  // `npx wrangler secret put APP_SECRET`. For local dev, copy .dev.vars.example to .dev.vars.
}
